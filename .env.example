DATABASE_URL=
DATABASE_URL_UNPOOLED=
# 32 bytes em hexadecimal (64 caracteres). Não altere após salvar credenciais.
BASECONTROL_ENCRYPTION_KEY=
NEXT_PUBLIC_APP_NAME=BaseControl
APP_URL=http://localhost:3000
# embedded para Node persistente; external com pnpm worker em outro processo.
BASECONTROL_WORKER=embedded
# Hosts exatos permitidos, separados por vírgula. Obrigatório em produção.
BASECONTROL_ALLOWED_HOSTS=
# Apenas atrás de proxy confiável que reescreva X-Forwarded-For.
BASECONTROL_TRUST_PROXY=false
# Política de transporte dos servidores externos, configurada apenas no backend.
BASECONTROL_EXTERNAL_TLS=true
